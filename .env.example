# Copia este archivo como ".env" y completa los valores.
# Nunca subas el archivo .env a GitHub: contiene la clave de la IA y el PIN.

# IA de NVIDIA (clave gratuita en https://build.nvidia.com)
NVIDIA_API_KEY=
# Modelo de texto. Vacío = nvidia/nemotron-3.5-lightning-30b-a3b (rápido, unos 5 s por cuento).
# Otras opciones: minimaxai/minimax-m3.1-flash (mejor redacción, unos 40 s), openai/gpt-oss-20b.
NVIDIA_MODEL=

# Voz para leer en voz alta (Microsoft Edge TTS, necesita internet).
# Vacío = es-CO-SalomeNeural (español de Colombia, mujer). Otras: es-CO-GonzaloNeural, es-US-PalomaNeural.
TTS_VOICE=

# Nombre de la escuela, que aparece en la barra lateral.
ESCUELA_NOMBRE=Escuela demo

# PIN que pide la página de la escuela para subir o borrar materiales. Usa uno difícil de adivinar.
ESCUELA_PIN=
